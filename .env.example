# Personal Wellbeing Companion - Environment Variables
# Copy this file to .env and fill in your values

# ===================
# GROQ CONFIGURATION
# ===================
# Get your API key from https://console.groq.com/keys
GROQ_API_KEY=your-groq-api-key-here
GROQ_CHAT_MODEL=openai/gpt-oss-120b
GROQ_SAFETY_MODEL=openai/gpt-oss-20b

# ===================
# CRISIS HELPLINES
# ===================
# Use your app's real frontend origin and have Koko allowlist it.
# Do not set this to a Koko-owned origin.
KOKO_HELPLINES_API_URL=https://helpline-api.koko.ai/crisis_helplines
KOKO_API_ORIGIN=http://localhost:5173

# ===================
# SECURITY
# ===================
# Generate a secure secret key: openssl rand -hex 32
SECRET_KEY=your-secret-key-here

# ===================
# DATABASE (defaults)
# ===================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=wellbeing
POSTGRES_PASSWORD=wellbeing
POSTGRES_DB=wellbeing

# ===================
# APPLICATION
# ===================
DEBUG=false